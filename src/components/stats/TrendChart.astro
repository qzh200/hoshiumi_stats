---
/**
 * 24h 访问趋势(ECharts 折线图)
 * - chart 容器相对定位;loading / error / empty 三种占位 absolute 覆盖
 * - 避免 SSR 时 DOM 节点高度跳变
 */
---

<section
  class="glass px-6 py-6 sm:px-7 sm:py-7"
  data-stats-card="trend"
  data-stats-status="loading"
  aria-label="最近 24 小时页面浏览量"
>
  <header class="flex items-baseline justify-between gap-3 mb-4">
    <div>
      <h2 class="text-base font-semibold text-ink-900">24 小时趋势</h2>
      <p class="text-xs text-ink-700 mt-0.5">最近 24 小时 · 页面浏览量</p>
    </div>
    <div class="flex items-center gap-3 text-xs text-ink-700">
      <span class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full" style="background:#7f9df2"></span>
        <span>浏览量</span>
      </span>
      <span class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full" style="background:rgba(157,146,236,0.6)"></span>
        <span>访问数</span>
      </span>
    </div>
  </header>

  <div class="relative" style="height: 280px; min-height: 240px">
    <div
      id="trend-chart"
      class="absolute inset-0 w-full h-full"
      role="img"
      aria-label="最近 24 小时浏览量折线图"
    >
    </div>

    <div
      data-stats-loading-default
      class="absolute inset-0 flex items-center justify-center text-xs text-ink-500"
    >
      正在加载趋势数据…
    </div>
    <div
      data-stats-error-default
      hidden
      class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-center"
    >
      <p class="text-xs text-ink-500" data-error-message>趋势数据暂不可用</p>
      <button
        type="button"
        data-retry="retry-trend"
        class="text-[11px] px-3 py-1 rounded-full border border-primary/30 text-primary hover:bg-primary/10 transition-colors"
      >
        重试
      </button>
    </div>
    <div
      data-stats-empty-default
      hidden
      class="absolute inset-0 flex items-center justify-center text-xs text-ink-500"
    >
      暂无访问数据
    </div>
  </div>
</section>
