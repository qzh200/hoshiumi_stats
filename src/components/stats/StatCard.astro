---
/**
 * 通用数字卡片
 * - 一张大数字 + 副标签
 * - 默认带 loading;client 成功时显示 data-stat-value,失败时切到 error slot
 * - iconName: lucide 图标名(纯内联 SVG 简版,避免引入 lucide 依赖)
 */
import Loading from '~/components/common/Loading.astro';
import ErrorState from '~/components/common/ErrorState.astro';

interface Props {
  /** 唯一 key,client 端用来 fill 数据 */
  name: string;
  /** 卡片标题(短) */
  label: string;
  /** Lucide 图标名 */
  iconName?:
    | 'eye'
    | 'users'
    | 'activity'
    | 'globe'
    | 'clock'
    | 'trending-up'
    | 'mouse-pointer-click'
    | 'radio';
  /** 主数字(默认 '—',可由 client script 覆盖) */
  value?: string | number;
  /** 副标签(主数字下方,如 "30 min" / "今日") */
  hint?: string;
  /** 是否整张卡片作为 stat 容器(根节点用 data-stats-card) */
  isCard?: boolean;
  class?: string;
  /** 重试按钮触发的客户端钩子 */
  retryId?: string;
}

const {
  name,
  label,
  iconName = 'activity',
  value = '—',
  hint,
  isCard = true,
  class: className = '',
  retryId,
} = Astro.props;
---

<article
  class:list={[
    'glass px-5 py-5 sm:px-6 sm:py-6 flex flex-col gap-3 min-h-[124px]',
    className,
  ]}
  data-stats-card={isCard ? name : undefined}
  data-stat-key={name}
  data-stats-status="loading"
>
  <div class="flex items-center justify-between gap-2">
    <span class="text-xs uppercase tracking-wider text-ink-500">{label}</span>
    <span class="text-ink-500" aria-hidden="true">
      {iconName === 'eye' && (
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
      )}
      {iconName === 'users' && (
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      )}
      {iconName === 'activity' && (
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/></svg>
      )}
      {iconName === 'globe' && (
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      )}
      {iconName === 'clock' && (
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      )}
      {iconName === 'trending-up' && (
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
      )}
      {iconName === 'mouse-pointer-click' && (
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 9l3-9 7 6-11 1 3 9-2 1-3-9"/><path d="M22 12l-4.6 4.6a2 2 0 0 1-2.8 0L12 14"/></svg>
      )}
      {iconName === 'radio' && (
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"/><path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"/></svg>
      )}
    </span>
  </div>

  <div class="flex-1 flex flex-col justify-center">
    <p
      class="text-2xl sm:text-3xl font-semibold text-ink-900 tabular-nums tracking-tight"
      data-stat-value={name}
    >
      {value}
    </p>
    {hint && <p class="mt-1 text-xs text-ink-700" data-stat-hint={name}>{hint}</p>}
  </div>

  <div data-stats-loading-default hidden>
    <Loading compact />
  </div>
  <div data-stats-error-default hidden>
    <ErrorState compact message="加载失败" retryId={retryId ?? `retry-${name}`} />
  </div>
</article>
