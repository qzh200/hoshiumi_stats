---
/**
 * Loading 通用骨架(每个 StatCard 内嵌一个,统一视觉)
 * - 默认占满父容器高度
 * - 用 shimmer 动画传达"加载中"信号
 */
interface Props {
  /** 高度提示(用于 aria-busy 占位) */
  label?: string;
  /** 紧凑模式(更小内边距) */
  compact?: boolean;
  class?: string;
}

const { label = '加载中…', compact = false, class: className = '' } = Astro.props;
---

<div
  class:list={[
    'flex items-center justify-center gap-2 text-ink-700/80 text-sm',
    compact ? 'py-1' : 'py-3',
    className,
  ]}
  role="status"
  aria-live="polite"
  aria-busy="true"
>
  <span class="loading-dot" aria-hidden="true"></span>
  <span class="loading-dot" aria-hidden="true" style="animation-delay: 0.15s"></span>
  <span class="loading-dot" aria-hidden="true" style="animation-delay: 0.3s"></span>
  <span class="sr-only">{label}</span>
</div>

<style>
  .loading-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: linear-gradient(120deg, #7f9df2, #9d92ec);
    animation: dotBounce 1.2s ease-in-out infinite;
    display: inline-block;
  }
  @keyframes dotBounce {
    0%,
    80%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    40% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
