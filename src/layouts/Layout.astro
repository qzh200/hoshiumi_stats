---
/**
 * 基础布局
 * - HTML 框架 + 极光背景 + 主题色变量
 * - 主题色由 config/stats.yaml 编译为 CSS 变量,注入到 :root
 * - 星星位置由固定种子生成,与 hoshiumi_home / hoshiumi_drive 同算法
 * - 左上角「返回 Hoshiumi 主页」链接 + 右上角三态切换,与 home 镜像
 * - 客户端脚本:由 Astro 编译为 module 并 bundle
 */
import '~/styles/global.css';
import BackLink from '~/components/layout/BackLink.astro';
import ThemeToggle from '~/components/layout/ThemeToggle.astro';
import { getStatsConfig } from '~/config/loader';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '星海观测台 · Hoshiumi Network Observatory',
  description = '星海观测台：Hoshiumi 全站实时流量分析。所有数据由你的浏览器直连 Umami Cloud 拉取——本站无后端、无数据库、无 Cookie、无埋点。',
} = Astro.props;

// 从 config 编译出主题色 CSS 变量,inline 注入到 <head>,
// 这样不依赖外部 stylesheet 也能在首帧前应用主题色
const { theme, umami, background } = getStatsConfig();
const themeCss = `:root{${[
  `--color-bg:${theme.light.background}`,
  `--color-primary:${theme.light.primary}`,
  `--color-secondary:${theme.light.secondary}`,
  `--color-accent:${theme.light.accent}`,
].join(';')}}${`:root[data-theme="dark"]{${[
  `--color-bg:${theme.dark.background}`,
  `--color-primary:${theme.dark.primary}`,
  `--color-secondary:${theme.dark.secondary}`,
  `--color-accent:${theme.dark.accent}`,
].join(';')}}`}`;

/* ------------------------------------------------------------------ */
/* 星星：使用固定种子生成可复现的伪随机位置（与 home 一致）            */
/* ------------------------------------------------------------------ */
function mulberry32(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function hashString(value: string): number {
  let hash = 2166136261;
  for (let i = 0; i < value.length; i++) {
    hash ^= value.charCodeAt(i);
    hash = Math.imul(hash, 16777619);
  }
  return hash >>> 0;
}

interface StarStyle {
  left: string;
  top: string;
  animationDelay: string;
  animationDuration: string;
  kind: 'sm' | 'lg';
}

const starsEnabled = background?.stars?.enabled !== false;
const starCount = background?.stars?.count ?? 22;
const stars: StarStyle[] = [];
if (starsEnabled) {
  const rand = mulberry32(hashString(`${umami.websiteId}#stats-stars`));
  for (let i = 0; i < starCount; i++) {
    stars.push({
      left: `${Math.round(rand() * 98)}%`,
      top: `${Math.round(rand() * 96)}%`,
      animationDelay: `${(rand() * 6).toFixed(2)}s`,
      animationDuration: `${(4.5 + rand() * 4.5).toFixed(2)}s`,
      kind: rand() > 0.82 ? 'lg' : 'sm',
    });
  }
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={theme.light.background} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={theme.dark.background} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site?.href ?? 'https://stats.hoshiumi.xyz'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hoshiumi · 星海日和" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://stats.hoshiumi.xyz" />
    <meta property="og:image" content="/og.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og.svg" />

    <!-- 配置驱动的浅色 / 深色 主题色变量(早于 stylesheet 注入,避免 FOUC) -->
    <style set:html={themeCss}></style>

    <!-- 主题引导(避免首帧闪烁),并暴露 window.statsTheme 给 ThemeToggle -->
    <script is:inline>
      (function () {
        try {
          var KEY = 'stats-theme';
          var root = document.documentElement;
          var allowSwitch = true;
          var def = 'system';
          var stored = null;
          try { stored = localStorage.getItem(KEY); } catch (e) { /* noop */ }
          var choice = stored && allowSwitch ? stored : def;
          if (choice !== 'light' && choice !== 'dark' && choice !== 'system') choice = 'system';
          var mq = window.matchMedia('(prefers-color-scheme: dark)');
          function effective(c) { return c === 'system' ? (mq.matches ? 'dark' : 'light') : c; }
          function apply() {
            root.setAttribute('data-theme', effective(choice));
            root.setAttribute('data-theme-choice', choice);
          }
          apply();
          if (typeof mq.addEventListener === 'function') {
            mq.addEventListener('change', function () { if (choice === 'system') apply(); });
          }
          window.statsTheme = {
            get: function () { return choice; },
            set: function (next) {
              choice = next === 'light' || next === 'dark' || next === 'system' ? next : 'system';
              try { localStorage.setItem(KEY, choice); } catch (e) { /* noop */ }
              apply();
            },
          };
        } catch (e) { /* noop */ }
      })();
    </script>

    <!-- 配置埋点(给 client script 读取;非 secret) -->
    <script is:inline define:vars={{ shareId: umami.shareId, websiteId: umami.websiteId, baseUrl: umami.baseUrl, shareContext: umami.shareContext, pollMs: umami.realtimePollMs, statsPollMs: umami.statsPollMs }}>
      window.__HOSHUMI_CONFIG__ = { shareId, websiteId, baseUrl, shareContext, pollMs, statsPollMs };
    </script>
  </head>
  <body>
    <!-- 极光背景层（与 hoshiumi_home 同结构：底色 + 渐变 + 光斑 + 星星 + 噪点） -->
    <div class="bg-scene" aria-hidden="true">
      <div class="bg-scene__layer bg-scene__tint"></div>
      <div class="bg-scene__layer">
        <div class="orb orb--a"></div>
        <div class="orb orb--b"></div>
        <div class="orb orb--c"></div>
      </div>
      <div class="bg-scene__layer">
        {stars.map((star) => (
          <i
            class:list={['star', star.kind === 'lg' ? 'star--lg' : 'star--sm']}
            style={`left:${star.left};top:${star.top};animation-delay:${star.animationDelay};animation-duration:${star.animationDuration}`}
          />
        ))}
      </div>
      <div class="bg-scene__layer bg-scene__noise"></div>
    </div>

    <!-- 左上角「返回 Hoshiumi 主页」 -->
    <BackLink />
    <!-- 右上角三态主题切换(与 home / drive 同款) -->
    <ThemeToggle />

    <slot />

    <!-- 客户端逻辑(由 Astro 编译为 module 并 bundle) -->
    <script>
      import '~/scripts/bootstrap.ts';
    </script>
  </body>
</html>
